@model BE_TraThiDiemQuynh.Models.ViewModel.ProductDetailVM
@{
    ViewBag.Title = "Product Details";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<head>
    <style>
        .pro {
            padding: 50px 10px 50px 10px;
            background-color: ghostwhite;
        }

        .pro-section {
            background-color: white;
            border-radius: 10px;
            border: 1px solid #ffffff;
            margin: 10px;
        }

            .pro-section img {
                max-height: 250px;
                max-width: 200px;
                padding: 5px;
            }

        .pro-price {
            font-weight: bolder;
            font-size: larger;
            color: red;
        }
        .pro-sale{
            font-weight:lighter;
        }
    </style>
</head>
<div class="container-fluid pro">
    <div class="div-horizontal">
        @*Khối bên trái*@
        <div class="col-md-3 pro-section">
            @*Phần thông tin sản phẩm*@
            <div>
                <h4><strong>@Html.DisplayFor(model=>model.product.ProductName)</strong></h4>
                <p class="pro-sale">Đã bán:&nbsp; @Model.product.OrderDetail.Count</p>
                <p class="pro-price">@Model.product.ProductPrice.ToString("C")</p>
                <p>Tủ sách:&nbsp;@Model.product.Category.CategoryName</p>
                <hr />
                <h5><strong>Mô tả</strong></h5>
                <p> @Model.product.ProductDecription</p>
            </div>
            <hr />

            @*Khối Related Product*@
            <div>@Html.Partial("_PVRelatedProduct", Model)</div>
        </div>
        @*Khối bên phải*@
        <div class="col-md-3 pro-section">
            <div class="form-group">
                @*Phần tạm tính*@
                        @using (Html.BeginForm("ProductDetails", "Home", FormMethod.Get))
                        {
                            <h4><strong>Số lượng</strong></h4>
                            <p>@Html.TextBoxFor(model=>model.Quantity, new
                          {@class="form-control", @tyle="number", @min=1}    )</p>
                            <h4><strong>Tạm tính</strong></h4>
                            <p>@Model.estimatedValue.ToString("NO")</p> 
                            <p>
                                @Html.ActionLink("Thêm vào giỏ hàng", "AddToCart", "Cart", new
                           { id = Model.product.ProductID, quanlity = Model.Quantity }, new
                           {
                               @class="btn btn-info"
                           })
                            </p>   
                        }
                <hr /> 
             </div>
            @*Khối TopProduct*@
            <div>@Html.Partial("_PVTopProduct", Model)</div>
        </div>
    </div>
</div>